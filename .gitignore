# ================================
# FileViz — .gitignore
# ================================

# Local file index (contains personal file paths — never commit)
**/fileindex.json
**/searchcache.json
**/search-results.json
**/current-folder-context-lookingAt.json

# Build output
backend-folder-jeremy/FileViz/bin/
backend-folder-jeremy/FileViz/obj/
*.dll
*.exe
*.pdb

# Visual Studio / Rider
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/
project.lock.json

# OS
.DS_Store
Thumbs.db